// ============================================================
// POWERFUL MUSIC REACTOR
// NO BOTTOM SOUNDWAVE
// COLOR SHIFTING CIRCLES
// WHITE / SPACE / AUDIO REACTIVE
// SHADERTOY
// ============================================================

#define PI 3.14159265359

// ============================================================
// AUDIO
// ============================================================

float FFT(float x)
{
    return texture(
        iChannel0,
        vec2(clamp(x, 0.0, 1.0), 0.25)
    ).r;
}

// ============================================================
// BASS
// ============================================================

float Bass()
{
    float b = 0.0;

    b += FFT(0.01);
    b += FFT(0.025);
    b += FFT(0.045);
    b += FFT(0.065);
    b += FFT(0.09);

    return b / 5.0;
}

// ============================================================
// MID
// ============================================================

float Mid()
{
    return (
        FFT(0.12) +
        FFT(0.18) +
        FFT(0.25) +
        FFT(0.32)
    ) * 0.25;
}

// ============================================================
// HIGH
// ============================================================

float High()
{
    return (
        FFT(0.45) +
        FFT(0.60) +
        FFT(0.75) +
        FFT(0.90)
    ) * 0.25;
}

// ============================================================
// HASH
// ============================================================

float hash21(vec2 p)
{
    p = fract(
        p * vec2(123.34, 456.21)
    );

    p += dot(
        p,
        p + 45.32
    );

    return fract(
        p.x * p.y
    );
}

// ============================================================
// HSV → RGB
// ============================================================

vec3 hsv2rgb(vec3 c)
{
    vec3 p = abs(
        fract(
            c.xxx +
            vec3(
                0.0,
                0.6667,
                0.3333
            )
        )
        * 6.0 - 3.0
    );

    return c.z *
        mix(
            vec3(1.0),
            clamp(
                p - 1.0,
                0.0,
                1.0
            ),
            c.y
        );
}

// ============================================================
// SPACE STARS
// ============================================================

float stars(vec2 uv)
{
    vec2 grid =
        floor(uv * 85.0);

    vec2 cell =
        fract(uv * 85.0) - 0.5;

    float rnd =
        hash21(grid);

    float d =
        length(cell);

    float star =
        smoothstep(
            0.075,
            0.0,
            d
        );

    star *=
        step(0.91, rnd);

    return star;
}

// ============================================================
// SPACE PARTICLES
// ============================================================

float particles(vec2 uv)
{
    vec2 p =
        uv * 40.0;

    vec2 id =
        floor(p);

    vec2 gv =
        fract(p) - 0.5;

    float rnd =
        hash21(id);

    float d =
        length(gv);

    float particle =
        smoothstep(
            0.045,
            0.0,
            d
        );

    particle *=
        step(0.88, rnd);

    return particle;
}

// ============================================================
// REACTOR RING
// ============================================================

float reactorRing(
    vec2 p,
    float radius
)
{
    float angle =
        atan(
            p.y,
            p.x
        );

    float audioX =
        fract(
            angle /
            (PI * 2.0)
            + 0.5
        );

    float spectrum =
        FFT(audioX);

    float r =
        radius +
        spectrum * 0.32;

    float d =
        abs(
            length(p) - r
        );

    float thickness =
        0.004 +
        spectrum * 0.022;

    return smoothstep(
        thickness,
        0.0,
        d
    );
}

// ============================================================
// ENERGY RAYS
// ============================================================

float energyRays(vec2 p)
{
    float angle =
        atan(
            p.y,
            p.x
        );

    float audioX =
        fract(
            angle /
            (PI * 2.0)
            + 0.5
        );

    float audio =
        FFT(audioX);

    float rays =
        pow(
            max(
                0.0,
                sin(
                    angle * 75.0
                    + iTime * 0.4
                )
            ),
            18.0
        );

    float radius =
        length(p);

    rays *=
        smoothstep(
            0.9,
            0.15,
            radius
        );

    rays *=
        audio * 2.5;

    return rays;
}

// ============================================================
// OUTER RING
// ============================================================

float outerRing(
    vec2 p,
    float radius
)
{
    float d =
        abs(
            length(p) -
            radius
        );

    return smoothstep(
        0.009,
        0.0,
        d
    );
}

// ============================================================
// MAIN
// ============================================================

void mainImage(
    out vec4 fragColor,
    in vec2 fragCoord
)
{
    // --------------------------------------------------------
    // UV
    // --------------------------------------------------------

    vec2 uv =
        fragCoord.xy /
        iResolution.xy;

    vec2 p =
        uv - 0.5;

    p.x *=
        iResolution.x /
        iResolution.y;

    float t =
        iTime;

    // --------------------------------------------------------
    // AUDIO
    // --------------------------------------------------------

    float B =
        Bass();

    float M =
        Mid();

    float H =
        High();

    // ========================================================
    // DARK SPACE BACKGROUND
    // ========================================================

    vec3 col =
        vec3(
            0.001,
            0.003,
            0.008
        );

    // --------------------------------------------------------
    // STARS
    // --------------------------------------------------------

    float star =
        stars(
            uv +
            vec2(
                t * 0.002,
                t * 0.001
            )
        );

    col +=
        vec3(
            0.35,
            0.45,
            0.65
        )
        * star;

    // --------------------------------------------------------
    // PARTICLES
    // --------------------------------------------------------

    float part =
        particles(
            uv +
            vec2(
                t * 0.01,
                -t * 0.018
            )
        );

    col +=
        vec3(
            0.5,
            0.65,
            0.9
        )
        * part
        * (
            0.5 +
            H * 3.0
        );

    // ========================================================
    // DYNAMIC COLOR
    // ========================================================

    float hue =
        fract(
            0.58
            + t * 0.035
            + B * 0.32
            + M * 0.18
        );

    // Main circle
    vec3 color1 =
        hsv2rgb(
            vec3(
                hue,
                0.88,
                1.0
            )
        );

    // Second circle
    vec3 color2 =
        hsv2rgb(
            vec3(
                fract(
                    hue + 0.16
                ),
                0.92,
                1.0
            )
        );

    // Third circle
    vec3 color3 =
        hsv2rgb(
            vec3(
                fract(
                    hue + 0.32
                ),
                0.88,
                1.0
            )
        );

    // ========================================================
    // MAIN REACTOR RINGS
    // ========================================================

    float ring1 =
        reactorRing(
            p,
            0.17 +
            B * 0.07
        );

    float ring2 =
        reactorRing(
            p,
            0.27 +
            M * 0.08
        );

    float ring3 =
        reactorRing(
            p,
            0.39 +
            H * 0.06
        );

    // --------------------------------------------------------
    // COLORFUL CIRCLES
    // --------------------------------------------------------

    col +=
        color1 *
        ring1 *
        (
            3.0 +
            B * 6.0
        );

    col +=
        color2 *
        ring2 *
        (
            2.2 +
            M * 5.0
        );

    col +=
        color3 *
        ring3 *
        (
            1.8 +
            H * 4.0
        );

    // ========================================================
    // OUTER RINGS
    // ========================================================

    float outer1 =
        outerRing(
            p,
            0.48 +
            B * 0.12
        );

    float outer2 =
        outerRing(
            p,
            0.58 +
            M * 0.10
        );

    col +=
        color1 *
        outer1 *
        (
            0.7 +
            B * 2.0
        );

    col +=
        color2 *
        outer2 *
        (
            0.5 +
            M * 2.0
        );

    // ========================================================
    // CENTRAL CORE
    // ========================================================

    float radius =
        length(p);

    float core =
        exp(
            -radius * 19.0
        );

    core *=
        0.4 +
        B * 7.0;

    col +=
        color1 *
        core;

    // ========================================================
    // WHITE HOT CENTER
    // ========================================================

    float center =
        exp(
            -radius * 55.0
        );

    center *=
        0.5 +
        B * 12.0;

    col +=
        vec3(1.0)
        * center;

    // ========================================================
    // ENERGY RAYS
    // ========================================================

    float rays =
        energyRays(p);

    col +=
        color2 *
        rays *
        (
            1.0 +
            H * 2.0
        );

    // ========================================================
    // BASS EXPLOSION
    // ========================================================

    float pulseRadius =
        0.32 +
        B * 0.35;

    float pulse =
        smoothstep(
            0.025,
            0.0,
            abs(
                radius -
                pulseRadius
            )
        );

    pulse *=
        B * 3.0;

    col +=
        color3 *
        pulse;

    // ========================================================
    // AUDIO REACTIVE OUTER GLOW
    // ========================================================

    float glow =
        exp(
            -abs(
                radius -
                (0.43 + B * 0.12)
            ) * 12.0
        );

    glow *=
        0.15 +
        B * 1.5;

    col +=
        color1 *
        glow;

    // ========================================================
    // VERTICAL ENERGY
    // ========================================================

    float vertical =
        exp(
            -abs(
                uv.x - 0.5
            ) * 10.0
        );

    vertical *=
        smoothstep(
            0.95,
            0.15,
            uv.y
        );

    vertical *=
        B * 0.22;

    col +=
        color1 *
        vertical;

    // ========================================================
    // VIGNETTE
    // ========================================================

    float vignette =
        1.0 -
        smoothstep(
            0.25,
            0.9,
            length(p)
        );

    col *=
        0.52 +
        vignette * 0.9;

    // ========================================================
    // BLOOM
    // ========================================================

    col +=
        pow(
            col,
            vec3(2.5)
        )
        * 0.20;

    // ========================================================
    // HDR EXPOSURE
    // ========================================================

    col =
        1.0 -
        exp(
            -col * 1.45
        );

    // ========================================================
    // GAMMA
    // ========================================================

    col =
        pow(
            col,
            vec3(0.84)
        );

    // ========================================================
    // OUTPUT
    // ========================================================

    fragColor =
        vec4(
            col,
            1.0
        );
}
